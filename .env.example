# ---- LLM Provider ----
# Which backend generate.ts / refine.ts call: "ollama" (free, local, for dev/testing)
# or "anthropic" (real model, requires LLM_API_KEY, used for actual generation quality)
LLM_PROVIDER=ollama

# Model name — meaning depends on LLM_PROVIDER above.
# e.g. "qwen2.5" for ollama, "claude-sonnet-4-6" for anthropic
LLM_MODEL=qwen2.5

# Required only when LLM_PROVIDER=anthropic. Leave blank for ollama.
LLM_API_KEY=

# Required only when LLM_PROVIDER=ollama. Ollama's default local server address.
OLLAMA_BASE_URL=http://localhost:11434

# ---- App config ----
# Base URL the app runs at locally
NEXT_PUBLIC_APP_URL=http://localhost:3000